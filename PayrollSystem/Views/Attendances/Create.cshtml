@model PayrollSystem.Models.Attendance

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Attendance</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="EmployeeId" class="control-label">Employee</label>

                <select asp-for="EmployeeId"
                        class="form-control"
                        asp-items="ViewBag.EmployeeId">
                    <option value="">-- Select Employee --</option>
                </select>

                <span asp-validation-for="EmployeeId"
                      class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AttendanceDate" class="control-label"></label>
                <input asp-for="AttendanceDate" class="form-control" />
                <span asp-validation-for="AttendanceDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TimeIn" class="control-label"></label>
                <input asp-for="TimeIn" class="form-control" />
                <span asp-validation-for="TimeIn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TimeOut" class="control-label"></label>
                <input asp-for="TimeOut" class="form-control" />
                <span asp-validation-for="TimeOut" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LateMinutes" class="control-label"></label>
                <input asp-for="LateMinutes" class="form-control" />
                <span asp-validation-for="LateMinutes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BreakMinutes" class="control-label"></label>
                <input asp-for="BreakMinutes" class="form-control" />
                <span asp-validation-for="BreakMinutes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MinutesWorked" class="control-label"></label>
                <input asp-for="MinutesWorked" class="form-control" />
                <span asp-validation-for="MinutesWorked" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
