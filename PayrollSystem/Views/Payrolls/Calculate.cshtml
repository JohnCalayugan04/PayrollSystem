@{
    ViewData["Title"] = "Calculate Payroll";
}

<h1>Calculate Payroll</h1>

<hr />

<form asp-action="Calculate" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="form-group mb-3">
        <label class="control-label">Employee</label>

        <select name="employeeId"
                class="form-control"
                asp-items="ViewBag.Employees">

            <option value="">-- Select Employee --</option>

        </select>
    </div>

    <div class="form-group mb-3">
        <label class="control-label">
            Payroll Period Start
        </label>

        <input type="date"
               name="periodStart"
               class="form-control"
               required />
    </div>

    <div class="form-group mb-3">
        <label class="control-label">
            Payroll Period End
        </label>

        <input type="date"
               name="periodEnd"
               class="form-control"
               required />
    </div>

    <hr />

    <h4>Payroll Adjustments</h4>

    <div class="form-group mb-3">
        <label class="control-label">
            Overtime Pay
        </label>

        <input type="number"
               name="overtimePay"
               class="form-control"
               step="0.01"
               min="0"
               value="0" />
    </div>

    <div class="alert alert-info">
        <strong>Cash Advance:</strong>
        Automatically calculated from Cash Advance records
        within the selected payroll period.
    </div>

    <div class="alert alert-info">
        <strong>Grocery:</strong>
        Automatically calculated from Grocery records
        within the selected payroll period.
    </div>

    <br />

    <button type="submit"
            class="btn btn-primary">
        Calculate Payroll
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}